# ── Clean URLs ────────────────────────────────────────────
RewriteEngine On

# No RewriteBase on purpose. Without it mod_rewrite takes the base from the
# directory this file sits in, so the same rules work at the domain root and
# in a staging subfolder. Hard-coding "/" breaks the subfolder copy.

# Force HTTPS. Uses REQUEST_URI rather than the captured path so a request to
# a subfolder keeps its folder instead of being thrown at the domain root.
#
# NOTE: this redirects before the certificate exists. If you deploy to a folder
# or domain whose SSL is not yet issued, comment these three lines out, install
# the certificate in hPanel, then put them back.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Strip .php from URLs
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Map extensionless URLs to .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ── Redirects from the old WordPress URLs ─────────────────
Redirect 301 /home/ /
Redirect 301 /for-customers/ /services
Redirect 301 /for-mechanics/ /join
Redirect 301 /about-us/ /about
Redirect 301 /mechanic-connect-frequently-asked-questions-faqs/ /faqs
Redirect 301 /privacy-policy-2/ /privacy
Redirect 301 /terms-of-service-end-user-agreement-for-mechanic-connect/ /terms
Redirect 301 /hello-world/ /

# Absolute by design: at the domain root this is correct. A staging copy in a
# subfolder falls back to the server's own 404 page, which is harmless.
ErrorDocument 404 /404.php

# ── Security ──────────────────────────────────────────────
Options -Indexes
<FilesMatch "\.(csv|log|md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Caching ───────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
